# Copy this file to .env and fill in real values.
# Never commit .env to git.

CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Nestlé OpenAI gateway base (no trailing slash)
# Full chat URL is built as:
#   {OPENAI_API_BASE_URL}/deployments/{DEPLOYMENT_NAME}/chat/completions?api-version={API_VERSION}
OPENAI_API_BASE_URL=https://your-gateway.example.com/api/your-openai-api/1/openai
DEPLOYMENT_NAME=ChatGPT
API_VERSION=2023-07-01-preview
